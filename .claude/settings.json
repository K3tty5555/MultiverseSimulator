{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-hardcoded-colors.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-json-loads.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-eventsource.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-component-size.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
