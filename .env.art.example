# LifePlanner 文生图 API 凭据（示例）
# 复制此文件为 .env.art 并填入真实 key：
#   cp .env.art.example .env.art
#   # 编辑 .env.art 填入 key
#
# 使用方式（跑立绘生成前）：
#   set -a && source .env.art && set +a
#
# 然后调用：
#   bun /Users/xiaowu/.claude/skills/baoyu-imagine/scripts/main.ts --batchfile backend/prompts/image-anchors/batch-sanguo-portraits.json

# 豆包 Seedream（当前立绘默认 provider）
ARK_API_KEY=your_ark_api_key_here

# 可选：其他 provider
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# REPLICATE_API_TOKEN=
